
---
import Shell from './Shell.astro';
import { Icon } from './Icons';
import { W } from '../lib/wizard-i18n';
import CompressPdf from './CompressPdf';
import MergePdf from './MergePdf';
import ImageToPdf from './ImageToPdf';
import PdfTool, { type PdfId } from './PdfTool';
import ToolMarkdown from './ToolMarkdown';
import ToolForms from './ToolForms';
import ToolEdit from './ToolEdit';
import ToolRedact from './ToolRedact';
import ToolCompare from './ToolCompare';
import ToolOcr from './ToolOcr';
import ToolSecure from './ToolSecure';
import { T, type Lang } from '../i18n';
import { TOOLS } from '../data/tools';
import { TI } from '../lib/tools-i18n';
import { TOOL_SEO, TOOL_SEO_HI } from '../data/tool-seo';

const { lang, slug } = Astro.props as { lang: Lang; slug: string };

const t = T[lang];
const base = lang === 'en' ? '/' : `/${lang}/`;
const tool = TOOLS.find((x) => x.slug === slug)!;
const [name, desc] = TI[lang][tool.id];

const PDF_IDS = [
  'split',
  'rotate',
  'organize',
  'pagenum',
  'watermark',
  'crop',
  'pdf2jpg',
  'sign',
  'repair',
];

// English SEO content. Hindi translations will be added separately.
const seo = lang === 'hi'
  ? TOOL_SEO_HI[tool.id]
  : TOOL_SEO[tool.id];

const relatedTools = seo
  ? seo.related
      .map((id) => TOOLS.find((x) => x.id === id))
      .filter((x) => x !== undefined)
  : [];
---

<Shell
  lang={lang}
  path={`tools/${slug}/`}
  title={`${lang === 'hi'
    ? name
    : ({
        resizer: 'Image Resizer Online',
        imgpdf: 'Convert Image to PDF',
        compress: 'Compress PDF Online',
        merge: 'Merge PDF Files',
        split: 'Split PDF Online',
        rotate: 'Rotate PDF Pages',
        organize: 'Organize PDF Pages',
        pagenum: 'Add Page Numbers to PDF',
        watermark: 'Add Watermark to PDF',
        crop: 'Crop PDF Online',
        pdf2jpg: 'Convert PDF to JPG',
        sign: 'Sign PDF Online',
        scan: 'Scan Documents to PDF',
        repair: 'Repair PDF Online',
        edit: 'Edit PDF Online',
        forms: 'Fill PDF Forms Online',
        pdf2md: 'Convert PDF to Markdown',
        redact: 'Redact PDF Online',
        compare: 'Compare PDF Files',
        ocr: 'Make Scanned PDFs Searchable',
        protect: 'Protect PDF with Password',
        unlock: 'Unlock PDF Password',
      } as Record<string, string>)[tool.id] ?? name
  } | Docs Are Easy`}
  desc={desc}
>
  <div class="toolhead">
    <a class="btn ghost" href={`${base}tools/`}>
      <Icon name="left" />{W[lang].back}
    </a>

    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={`${base}tools/`}>{t.navTools}</a>
      <svg class="i" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m9 18 6-6-6-6" />
      </svg>
      <strong aria-current="page">{name}</strong>
    </nav>

    <p class="lock end">{t.privacy}</p>
  </div>

  <h1>{name}</h1>
  <p class="sub">{desc}</p>

  <!-- Existing tool interfaces -->
  {tool.id === 'compress' && <CompressPdf client:load lang={lang} />}
  {tool.id === 'merge' && <MergePdf client:load lang={lang} />}
  {tool.id === 'scan' && <ImageToPdf client:load lang={lang} scan />}
  {PDF_IDS.includes(tool.id) && (
    <PdfTool client:load lang={lang} id={tool.id as PdfId} />
  )}
  {tool.id === 'pdf2md' && <ToolMarkdown client:load lang={lang} />}
  {tool.id === 'forms' && <ToolForms client:load lang={lang} />}
  {tool.id === 'edit' && <ToolEdit client:load lang={lang} />}
  {tool.id === 'redact' && <ToolRedact client:load lang={lang} />}
  {tool.id === 'compare' && <ToolCompare client:load lang={lang} />}
  {tool.id === 'ocr' && <ToolOcr client:load lang={lang} />}
  {tool.id === 'protect' && (
    <ToolSecure client:load lang={lang} mode="protect" />
  )}
  {tool.id === 'unlock' && (
    <ToolSecure client:load lang={lang} mode="unlock" />
  )}

  <!-- SEO content -->
  {seo && (
    <section class="tool-seo" aria-label="About this tool">
      <h2>{seo.heading}</h2>
      <p>{seo.intro}</p>

      <h2>How to use this tool</h2>
      <ol>
        {seo.howTo.map((step) => (
          <li>{step}</li>
        ))}
      </ol>

      <h2>Why use Docs Are Easy?</h2>
      <ul>
        {seo.benefits.map((benefit) => (
          <li>{benefit}</li>
        ))}
      </ul>

      <h2>Frequently asked questions</h2>
      {seo.faqs.map((faq) => (
        <div class="tool-faq">
          <h3>{faq.question}</h3>
          <p>{faq.answer}</p>
        </div>
      ))}

      <h2>Related PDF tools</h2>
      <ul>
        {relatedTools.map((related) => (
          <li>
            <a href={`${base}tools/${related.slug}/`}>
              {TI[lang][related.id][0]}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Shell>

<style>
  .tool-seo {
    max-width: 850px;
    margin: 56px auto 24px;
    padding-top: 32px;
    border-top: 1px solid var(--line, #e5e7eb);
    line-height: 1.75;
  }

  .tool-seo h2 {
    margin: 30px 0 12px;
    font-size: 1.35rem;
    line-height: 1.35;
  }

  .tool-seo h2:first-child {
    margin-top: 0;
  }

  .tool-seo p {
    margin: 0 0 16px;
    line-height: 1.75;
  }

  .tool-seo ol,
  .tool-seo ul {
    padding-left: 24px;
    margin: 12px 0 24px;
  }

  .tool-seo li {
    padding-left: 4px;
    margin-bottom: 9px;
  }

  .tool-faq {
    padding: 14px 0;
    border-bottom: 1px solid var(--line, #e5e7eb);
  }

  .tool-faq h3 {
    margin: 0 0 8px;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .tool-faq p {
    margin: 0;
  }

  .tool-seo a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
