---
import '../styles.css';
import { T, LANGS, type Lang } from '../i18n';

const { lang, path = '', title, desc, home = false } = Astro.props as { lang: Lang; path?: string; title: string; desc: string; home?: boolean };
const t = T[lang];
const href = (l: Lang, p = path) => (l === 'en' ? '/' : `/${l}/`) + p;
// The live address is not decided yet. Without SITE_URL no canonical or language-alternate links are written.
const abs = (l: Lang) => (Astro.site ? new URL(href(l), Astro.site).href : '');
const tabs = [
  { p: '', label: t.navHome, d: 'M3 11.5 12 4l9 7.5M5 10v10h5v-6h4v6h5V10' },
  { p: 'exam/', label: t.navExam, d: 'M6 3h9l4 4v14H6zM14 3v5h5M9 13h6M9 17h6' },
  { p: 'tools/', label: t.navTools, d: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z' },
];
const cur = path.startsWith('tools') ? 'tools/' : path.startsWith('exam') ? 'exam/' : '';
const copyright = t.copyright.replace('{year}', String(new Date().getFullYear()));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="application-name" content="Docs Are Easy" />
    <meta name="google-site-verification" content="08QFsvdSNyT2KvK9ffAs5w4pC_rbAFuyj5QTyMBGPs0" />
    {Astro.site && <link rel="canonical" href={abs(lang)} />}
    {Astro.site && LANGS.map((l) => <link rel="alternate" hreflang={l.code} href={abs(l.code)} />)}
    {Astro.site && <link rel="alternate" hreflang="x-default" href={abs('en')} />}
    <meta property="og:site_name" content="Docs Are Easy" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    {Astro.site && <meta property="og:url" content={abs(lang)} />}
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Docs Are Easy', description: desc, inLanguage: lang, ...(Astro.site ? { url: abs(lang) } : {}) })} />
    <script is:inline>
      (function(){try{var s=localStorage.getItem('dae-theme');var d=s?s==='dark':matchMedia('(prefers-color-scheme: dark)').matches;document.documentElement.dataset.theme=d?'dark':'light'}catch(e){document.documentElement.dataset.theme='light'}})();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class={home ? 'home' : undefined}>
     <div class="hwrap">
      <a class="brand" href={href(lang, '')}>
        <svg class="logo" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" fill="var(--acc)" /><path d="M10 7h8l5 5v13a1 1 0 0 1-1 1H10a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1z" fill="var(--accink)" /><path d="M13 19l2.5 2.5L20 16" stroke="var(--acc)" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
        Docs Are Easy
      </a>
      <nav class="topnav" aria-label="Main">
        {tabs.map((x) => <a href={href(lang, x.p)} aria-current={cur === x.p ? 'page' : undefined}>{x.label}</a>)}
      </nav>
      <div class="ctl">
        <nav class="langbar" aria-label="Language">
          {LANGS.map((l) => <a href={href(l.code)} hreflang={l.code} lang={l.code} aria-current={l.code === lang ? 'true' : undefined}>{l.label}</a>)}
        </nav>
        <button type="button" id="theme" class="iconbtn" aria-label={t.theme}>
          <svg class="i i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" /></svg>
          <svg class="i i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
        <details class="menu">
          <summary class="iconbtn" aria-label={t.menu}><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg></summary>
          <div class="menu-list">
            {LANGS.map((l) => <a href={href(l.code)} hreflang={l.code} lang={l.code} aria-current={l.code === lang ? 'true' : undefined}>{l.label}</a>)}
          </div>
        </details>
      </div>
     </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer><p>{t.disclaimer}</p><p>{copyright}</p></footer>
    <nav class="tabbar" aria-label="Main">
      {tabs.map((x) => (
        <a href={href(lang, x.p)} aria-current={cur === x.p ? 'page' : undefined}>
          <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d={x.d} /></svg>{x.label}
        </a>
      ))}
    </nav>
    <script is:inline>
      document.getElementById('theme').addEventListener('click',function(){var d=document.documentElement,n=d.dataset.theme==='dark'?'light':'dark';d.dataset.theme=n;try{localStorage.setItem('dae-theme',n)}catch(e){}});
    </script>
  </body>
</html>
