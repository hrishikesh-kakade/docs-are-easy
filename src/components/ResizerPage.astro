---
import Shell from './Shell.astro';
import { Icon } from './Icons';
import { W } from '../lib/wizard-i18n';
import ImageTool from './ImageTool';
import { T, type Lang } from '../i18n';
import { TI } from '../lib/tools-i18n';
const { lang } = Astro.props as { lang: Lang };
const t = T[lang];
const base = lang === 'en' ? '/' : `/${lang}/`;
---
<Shell lang={lang} path="tools/image-resizer/" title={t.metaTitle} desc={t.sub}>
  <div class="toolhead"><a class="btn ghost" href={`${base}tools/`}><Icon name="left" />{W[lang].back}</a><nav class="crumbs" aria-label="Breadcrumb"><a href={`${base}tools/`}>{t.navTools}</a><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg><strong aria-current="page">{TI[lang].resizer[0]}</strong></nav><p class="lock end">{t.privacy}</p></div>
  <h1>{t.h1}</h1>
  <p class="sub">{t.sub}</p>
  <ImageTool client:load lang={lang} />
</Shell>
